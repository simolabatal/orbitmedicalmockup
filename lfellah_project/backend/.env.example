# ─── L'FELLAH 2.0 ───
# Copiez ce fichier en .env et remplissez les valeurs

# ─── DJANGO ──────────────────────────────────────
DJANGO_SECRET_KEY=change-this-in-production-50-chars-min
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── BASE DE DONNÉES ─────────────────────────────
# sqlite | mysql | postgresql
DB_ENGINE=sqlite

# MySQL (si DB_ENGINE=mysql)
MYSQL_DB=lfellah_db
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# PostgreSQL (si DB_ENGINE=postgresql)
POSTGRES_DB=lfellah_db
POSTGRES_USER=lfellah_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── CELERY / REDIS ──────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# ─── EMAIL ───────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@lfellah.ma

# ─── CLÉS API ────────────────────────────────────
# ROTATED — remplacez par vos vraies clés dans le fichier .env (non versionné)
GEMINI_API_KEY=your-gemini-api-key-here
OPENWEATHER_API_KEY=your-openweather-api-key-here

# ─── WIFI ESP32 (pour la configuration par défaut des appareils) ───
# ROTATED — remplacez par vos vraies informations dans le fichier .env
DEVICE_WIFI_SSID=your-ssid-here
DEVICE_WIFI_PASSWORD=your-password-here

# ─── STRIPE (Paiements futurs) ───────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
